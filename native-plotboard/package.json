{
  "name": "groundtrack-plotboard",
  "author": "Groundtrack",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "pebble-app"
  ],
  "dependencies": {},
  "pebble": {
    "displayName": "Groundtrack Plotboard",
    "uuid": "c7a4133b-394c-436b-86cf-c08e37cbc014",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "configurable",
      "location"
    ],
    "messageKeys": [
      "Status",
      "Settings",
      "Segments",
      "RiseSets",
      "DataRequest",
      "DataBody",
      "SatSegments",
      "Passes",
      "Events"
    ],
    "resources": {
      "media": [
        {
          "type": "raw",
          "name": "MAP_PACK",
          "file": "map-world.pack"
        },
        {
          "type": "raw",
          "name": "FIGURES",
          "file": "figures.bin"
        },
        {
          "type": "raw",
          "name": "TABLES",
          "file": "tables.bin"
        }
      ]
    }
  }
}
