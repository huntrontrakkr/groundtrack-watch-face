# The standard Pebble SDK build: C in src/c, phone JavaScript in src/pkjs.
import os.path

top = '.'
out = 'build'
FACE = 'FACE_ENROUTE'


def options(ctx):
    ctx.load('pebble_sdk')


def configure(ctx):
    ctx.load('pebble_sdk')


def build(ctx):
    ctx.load('pebble_sdk')
    # Each watch's code blobs (native/src/c/blob.h), with the compiler the SDK
    # builds the app with: resources, packed with the rest.
    import os, shutil, subprocess, sys
    for platform in ctx.env.TARGET_PLATFORMS:
        cc = ctx.all_envs[platform].CC
        cc = shutil.which(cc[0] if isinstance(cc, list) else cc) or ''
        subprocess.check_call([sys.executable, os.path.join(ctx.path.abspath(), '..', 'tools', 'build-blobs.py'),
                               '--face', 'enroute', '--platform', platform,
                               '--out', os.path.join(ctx.path.abspath(), 'resources')] + (['--cc', cc] if cc else []))
    binaries = []
    cached_env = ctx.env
    for platform in ctx.env.TARGET_PLATFORMS:
        ctx.env = ctx.all_envs[platform]
        # Arithmetic as the JavaScript does it: no fused multiply-adds.
        # This project is Groundtrack Enroute (see src/c/face.h;
        # native-fuller/ builds the same sources as Groundtrack Fuller).
        # Optimised across the sources at link time: about 1.3 KB smaller,
        # and every byte of the app is a byte of its heap.
        ctx.env.append_value('CFLAGS', ['-ffp-contract=off', '-flto', '-D' + FACE])
        # The chart builder and the minute renderer as code blobs (src/c/blob.h).
        ctx.env.append_value('CFLAGS', ['-DGT_BLOBS=1'])
        # The Round 2's screen (src/c/enroute_core.h ENR_ROUND).
        if platform == 'gabbro':
            ctx.env.append_value('CFLAGS', ['-DENR_ROUND=1'])
        # The app's version is in the key of the ground it keeps (chart.c
        # keep_try): a new version makes it again.
        import json
        ctx.env.append_value('CFLAGS', ['-DGT_VERSION=\"%s\"' % json.load(open('package.json'))['version']])
        # (The app's header is referenced by nothing: -u keeps it through the link.)
        ctx.env.append_value('LINKFLAGS', ['-flto', '-Os', '-ffp-contract=off', '-Wl,-u,__pbl_app_info'])
        # Smaller still, for the polar charts' room: fewer functions inlined,
        # and loops left as written (about 2.4 KB; tools/energy measures
        # what it costs the watch's work).
        size = ['-fno-inline-functions-called-once', '-fno-early-inlining', '-fno-partial-inlining',
                '-fno-tree-tail-merge', '-fno-tree-pre', '-fno-reorder-blocks', '-fno-move-loop-invariants',
                '-fno-tree-dominator-opts', '-fno-tree-loop-im', '-fno-tree-scev-cprop']
        # (Groundtrack, the tighter, compiles its build-time sources smaller
        # still: src/c/build_size.h. Not the minute renderer, whose work is
        # a minute's, every minute.)
        size += ['-fmerge-all-constants', '-fno-caller-saves', '-fno-tree-bit-ccp', '-fno-reorder-functions']
        ctx.env.append_value('CFLAGS', size)
        ctx.env.append_value('LINKFLAGS', size)
        import os
        ctx.env.append_value('CFLAGS', os.environ.get('GT_FLAGS','').split())
        ctx.env.append_value('LINKFLAGS', os.environ.get('GT_FLAGS','').split())
        ctx.set_group(ctx.env.PLATFORM_NAME)
        app_elf = '{}/pebble-app.elf'.format(ctx.env.BUILD_DIR)
        # Doubles throughout, as the JavaScript: the SDK builds for the
        # Cortex-M3, where floats are software too, and single precision
        # moves a pixel of the Moon's phase or of night now and then.
        # (The app is main.c, watch_data.c and passes.c: the chart builder and
        # the minute renderer are its code blobs.)
        sources = [n for n in ctx.path.ant_glob('src/c/**/*.c') if n.name in ('main.c', 'watch_data.c', 'passes.c')]
        ctx.pbl_build(source=sources, target=app_elf, bin_type='app')
        binaries.append({'platform': platform, 'app_elf': app_elf})
    ctx.env = cached_env
    ctx.set_group('bundle')
    ctx.pbl_bundle(binaries=binaries,
                   js=ctx.path.ant_glob(['src/pkjs/**/*.js', 'src/pkjs/**/*.json']),
                   js_entry_file='src/pkjs/index.js')
