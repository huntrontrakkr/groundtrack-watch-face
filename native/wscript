# The standard Pebble SDK build: C in src/c, phone JavaScript in src/pkjs.
import os.path

top = '.'
out = 'build'
FACE = 'FACE_ENROUTE'


def options(ctx):
    ctx.load('pebble_sdk')


def configure(ctx):
    ctx.load('pebble_sdk')


def build(ctx):
    ctx.load('pebble_sdk')
    binaries = []
    cached_env = ctx.env
    for platform in ctx.env.TARGET_PLATFORMS:
        ctx.env = ctx.all_envs[platform]
        # Arithmetic as the JavaScript does it: no fused multiply-adds.
        # This project is Groundtrack Enroute (see src/c/face.h;
        # native-fuller/ builds the same sources as Groundtrack Fuller).
        # Optimised across the sources at link time: about 1.3 KB smaller,
        # and every byte of the app is a byte of its heap.
        ctx.env.append_value('CFLAGS', ['-ffp-contract=off', '-flto', '-D' + FACE])
        # (The app's header is referenced by nothing: -u keeps it through the link.)
        ctx.env.append_value('LINKFLAGS', ['-flto', '-Os', '-ffp-contract=off', '-Wl,-u,__pbl_app_info'])
        import os
        ctx.env.append_value('CFLAGS', os.environ.get('GT_FLAGS','').split())
        ctx.env.append_value('LINKFLAGS', os.environ.get('GT_FLAGS','').split())
        ctx.set_group(ctx.env.PLATFORM_NAME)
        app_elf = '{}/pebble-app.elf'.format(ctx.env.BUILD_DIR)
        # Doubles throughout, as the JavaScript: the SDK builds for the
        # Cortex-M3, where floats are software too, and single precision
        # moves a pixel of the Moon's phase or of night now and then.
        ctx.pbl_build(source=ctx.path.ant_glob('src/c/**/*.c'), target=app_elf, bin_type='app')
        binaries.append({'platform': platform, 'app_elf': app_elf})
    ctx.env = cached_env
    ctx.set_group('bundle')
    ctx.pbl_bundle(binaries=binaries,
                   js=ctx.path.ant_glob(['src/pkjs/**/*.js', 'src/pkjs/**/*.json']),
                   js_entry_file='src/pkjs/index.js')
